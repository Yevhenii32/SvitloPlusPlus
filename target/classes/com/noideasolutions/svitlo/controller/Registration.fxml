<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.noideasolutions.svitlo.controller.RegistrationController">
    <padding>
        <Insets bottom="20.0" left="40.0" right="40.0" top="20.0"/>
    </padding>

    <Label text="Svitlo++">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>

    <Label text="Реєстрація нового користувача" textFill="#555555" />

    <VBox spacing="5.0">
        <Label text="Логін:"/>
        <TextField fx:id="usernameField" promptText="Придумайте логін..." />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Пароль:"/>
        <PasswordField fx:id="passwordField" promptText="Придумайте пароль..." />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Повторіть пароль:"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Введіть пароль ще раз..." />
    </VBox>

    <VBox spacing="5.0">
        <Label text="Оберіть роль:"/>
        <ComboBox fx:id="roleComboBox" promptText="Оберіть роль..." prefWidth="200" />
    </VBox>

    <Label fx:id="statusLabel" textFill="RED" />

    <HBox alignment="CENTER" spacing="15.0">
        <Button onAction="#handleBackToLoginAction" text="Назад" prefWidth="100" prefHeight="30" />
        <Button onAction="#handleRegisterAction" text="Зареєструватися" prefWidth="130" prefHeight="30" />
    </HBox>
</VBox>