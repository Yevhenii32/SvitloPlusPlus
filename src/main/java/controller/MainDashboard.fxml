<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="600.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.noideasolutions.svitlo.controller.MainDashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #f4f4f4; -fx-border-color: #dcdcdc; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="10.0" left="20.0" right="20.0" top="10.0" />
            </padding>
            <Label text="Svitlo++">
                <font>
                    <Font name="System Bold" size="20.0" />
                </font>
            </Label>
            <Label fx:id="userInfoLabel" text="Завантаження..." />
            <HBox alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS" spacing="15.0">
                <ToggleButton fx:id="roleToggleButton" onAction="#handleRoleSwitch" text="Режим гостя" />
                <Button onAction="#handleLogoutAction" text="Вийти" />
            </HBox>
        </HBox>
    </top>
    <center>
        <SplitPane dividerPositions="0.3">
            <VBox spacing="10.0">
                <padding>
                    <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                </padding>
                <Label text="Доступні хаби">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <ListView fx:id="hubsListView" VBox.vgrow="ALWAYS" />
            </VBox>
            <StackPane style="-fx-background-color: #e0e0e0;">
                <Label text="Тут буде інтерактивна карта" textFill="#888888">
                    <font>
                        <Font size="18.0" />
                    </font>
                </Label>
            </StackPane>
        </SplitPane>
    </center>
</BorderPane>