<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" spacing="0.0"
      prefHeight="560.0" prefWidth="560.0"
      styleClass="root-container"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.noideasolutions.svitlo.controller.UserProfileController">

    <stylesheets>
        <URL value="@/com/noideasolutions/svitlo/styles/global.css" />
    </stylesheets>

    <!-- ХЕДЕР -->
    <VBox alignment="CENTER" styleClass="profile-hero">
        <padding><Insets top="32.0" bottom="28.0" left="40.0" right="40.0"/></padding>

        <!-- Аватар-заглушка -->
        <Label text="👤" styleClass="profile-avatar"/>

        <Label text="Мій Профіль" styleClass="brand-title">
            <font><Font name="System Bold" size="26.0"/></font>
            <VBox.margin><Insets top="8.0"/></VBox.margin>
        </Label>
        <Label fx:id="usernameLabel" text="Користувач" styleClass="label-muted">
            <font><Font size="14.0"/></font>
        </Label>
    </VBox>

    <!-- ТІЛО -->
    <VBox spacing="16.0" VBox.vgrow="ALWAYS" styleClass="form-body">
        <padding><Insets top="24.0" bottom="24.0" left="32.0" right="32.0"/></padding>

        <!-- КАРТКА ІНФО -->
        <HBox styleClass="profile-info-card" alignment="CENTER_LEFT" spacing="12.0">
            <padding><Insets top="16.0" bottom="16.0" left="20.0" right="20.0"/></padding>

            <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                <Label fx:id="roleLabel" text="Роль: —" styleClass="profile-role-label"/>
            </VBox>

            <VBox alignment="CENTER_RIGHT" spacing="2.0">
                <Label text="Мій баланс" styleClass="label-muted"/>
                <Label fx:id="bonusPointsLabel" text="0 балів" styleClass="profile-balance"/>
            </VBox>
        </HBox>

        <!-- ЗАГОЛОВОК СПИСКУ -->
        <Label text="🎁  Обмін балів на винагороди" styleClass="sidebar-card-title">
            <VBox.margin><Insets top="4.0"/></VBox.margin>
        </Label>

        <!-- СПИСОК НАГОРОД -->
        <ListView fx:id="rewardsListView" VBox.vgrow="ALWAYS" styleClass="hub-list"/>

        <!-- КНОПКИ -->
        <HBox spacing="12.0" alignment="CENTER">
            <VBox.margin><Insets top="4.0"/></VBox.margin>
            <Button text="← Назад до меню"
                    onAction="#handleBackAction"
                    styleClass="btn-back"
                    prefHeight="46.0"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            <Button text="🎁  Обміняти бали"
                    onAction="#handleRedeemAction"
                    styleClass="btn-login"
                    prefHeight="46.0"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
        </HBox>

    </VBox>
</VBox>